# Copy this file to .env and fill in the endpoint values.
# llm_endpoint.configure() reads .env at the project root on every call.
# A value exported in the shell wins over a value in this file.
# Django settings must be exported before startup or set in Railway variables;
# Django does not load this file automatically.

# --- required: the LLM endpoint ---
CHEAPERINFERENCE_API_KEY=sk-your-key-here
CHEAPERINFERENCE_BASE_URL=https://<your-endpoint-host>/v1

# --- Django ---
# Required for every Django command, including local development and tests.
# Generate at least 50 random characters; there is no shared fallback:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# 1 enables local HTTP development and debug pages. Keep it 0 on Railway;
# with debug off, session and CSRF cookies require HTTPS.
DJANGO_DEBUG=0
# Hostnames only, comma-separated; '*' is rejected. Defaults to localhost,
# 127.0.0.1 and [::1]. RAILWAY_PUBLIC_DOMAIN is added when present.
DJANGO_ALLOWED_HOSTS=
# Optional cross-origin browser clients, including https://; same-origin needs none.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set 1 only behind a trusted proxy that sets/strips X-Forwarded-Proto.
# Set 1 on Railway so HTTPS origin checks see the original scheme.
DJANGO_TRUST_PROXY=0

# --- optional error reporting (off unless a DSN is supplied) ---
# Use your own Sentry project. Only the production environment sends reports.
SENTRY_DSN=
# Railway's RAILWAY_ENVIRONMENT_NAME is used when this is unset.
# SENTRY_ENVIRONMENT=production

# Required to encrypt delegated inference credentials for durable queued jobs.
# Generate once after installing requirements.txt:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set the same value for the web process and queue worker. Keep it across
# restarts/redeploys; changing it while jobs still hold encrypted credentials
# prevents those jobs from resuming. Store the value as a Railway secret.
PROMPT_STUDIO_CREDENTIAL_KEY=
# Optional scored service jobs require an explicitly configured HTTPS inference
# base URL; there is no company endpoint default. Leave blank when unused.
PROMPT_STUDIO_INFERENCE_BASE_URL=

# Required for Cheaper Inference to call the bearer-authenticated service API.
# Generate a long random value and configure the same value in both services.
GEPA_SERVICE_API_KEY=
# Stable owner label used to isolate the service's in-memory jobs and run history.
GEPA_SERVICE_OWNER=service:cheaper-inference

# --- MLflow prompt registry ---
# Local default is sqlite:///mlflow.db in the working directory.
# The Docker image sets sqlite:////app/data/mlflow.db instead.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- optional ---
# Print the raw judge output when a judge score looks wrong.
# PROMPT_OPT_JUDGE_DEBUG=1
