# Never ship local state / caches into the image — start from a clean DB on the
# volume (DB_PATH), not the developer's laptop DB.
**/db.sqlite3
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
mlflow.db
mlflow.db-wal
mlflow.db-shm
mlruns/
**/__pycache__/
**/*.pyc
*.pyc
.idea/
.venv/
.git/
.gitignore
.github/
datasets/
examples/
manual/
.env
.env.*
# Separate optimization-worker runtime data must not enter the GEPA build context.
workers/optimization/models/
workers/optimization/nltk_data/

# Apply exclusions at every depth, including inside copied source directories.
**/.env
**/.env.*
**/.envrc
**/.venv
**/venv
**/.idea
**/.DS_Store
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
**/htmlcov
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.sql
**/*.dump
**/*.log
**/*.bak
**/*.backup
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.aws
**/.ssh
**/credentials
**/secrets
